VITE_API_URL=http://localhost:5234/api
# Public browser client ID; never put the Google client secret in a VITE_ variable.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Public Facebook App ID; the App Secret belongs only in backend configuration.
VITE_FACEBOOK_APP_ID=your-facebook-app-id
